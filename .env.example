# Local development (server/)
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/onfesta
SESSION_SECRET=change-me-to-a-long-random-string
# Use either plain (dev only) or hash (recommended for production):
ADMIN_PASSWORD=dev-only-password
