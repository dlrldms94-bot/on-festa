  {
    "path": "overviewIntro.p1",
    "v": "<span class=\"overview-intro-emph\">Discover the vibrant charms of Seoul,<br>where tradition meets modernity,</span><br>at Namsan, one of the city’s most iconic landmarks!"
  },
  {
    "path": "overviewIntro.p2",
    "v": "Experience everything from exciting K-pop<br>and live performances to traditional Korean performances<br>showcasing Korea’s beauty and spirit,<br>along with hands-on K-culture experiences and traditional games!"
  },
  {
    "path": "overviewIntro.p3",
    "v": "Enjoy a variety of activities, take part in the Stamp Tour,<br>and collect stamps to earn a special souvenir!"
  },
  {
    "path": "overviewIntro.p4",
    "v": "This fall, experience a special day in Seoul at Namsan.<br>Discover a new side of Seoul tourism<br><span class=\"overview-mark overview-mark--pink\">at the 2026 Seoul Tourism ON Festa!</span>"
  },
