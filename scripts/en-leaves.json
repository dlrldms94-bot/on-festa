    "path": "programParticipate.kpopTitle",
    "v": "K-POP Class Challenge"
  },
  {
    "path": "programParticipate.kpopLead",
    "v": "A one-day K-POP dance class at Namsan!"
  },
  {
    "path": "programParticipate.kpopDesc",
    "v": "Watch a performance by ONE MILLION AMAZON, then learn K-POP choreography yourself.\nA special session to learn and perform ATEEZ’s “BAD” together!\nFirst-timers welcome—everyone can join in and follow along.\nWatch, learn, dance together, and feel the energy of K-POP!"
  },
  {
    "path": "programParticipate.kpopDate",
    "v": "Sat, Oct 3, 2026 · 17:30–18:00"
  },
